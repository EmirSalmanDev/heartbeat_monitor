{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "title": "Service Up/Down",
      "description": "From the `up` series Alloy's scrape of api:3001/metrics and worker:9091/metrics generates and remote-writes to Prometheus — not a custom sentinel_* metric.",
      "type": "stat",
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" },
          "expr": "up{job=~\"sentinel/.+\"}",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red", "index": 0 },
                "1": { "text": "UP", "color": "green", "index": 1 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value_and_name",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center"
      },
      "pluginVersion": "11.5.1"
    },
    {
      "id": 2,
      "title": "HTTP Request Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" },
          "expr": "sum by (method, route) (rate(sentinel_http_requests_total[5m]))",
          "legendFormat": "{{method}} {{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "last"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 3,
      "title": "HTTP Error Rate (5xx)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" },
          "expr": "sum(rate(sentinel_http_requests_total{status_code=~\"5..\"}[5m]))",
          "legendFormat": "5xx/sec",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" },
          "expr": "sum(rate(sentinel_http_requests_total[5m]))",
          "legendFormat": "total/sec",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "last"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 4,
      "title": "API p95 Latency",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(sentinel_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 5,
      "title": "Ping Response Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" },
          "expr": "histogram_quantile(0.95, sum(rate(sentinel_ping_latency_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" },
          "expr": "rate(sentinel_ping_latency_seconds_sum[5m]) / rate(sentinel_ping_latency_seconds_count[5m])",
          "legendFormat": "avg",
          "refId": "B"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 6,
      "title": "Ping Success vs Failure Count",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" },
          "expr": "sum by (status) (rate(sentinel_ping_total[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "UP" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }]
          },
          {
            "matcher": { "id": "byName", "options": "DOWN" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum", "last"] },
        "tooltip": { "mode": "multi" }
      }
    },
    {
      "id": 7,
      "title": "Worker Job Throughput (ping executions/sec)",
      "description": "The worker exports no dedicated BullMQ queue-depth or job-count metric — sentinel_ping_total/sentinel_ping_latency_seconds are the only worker-side metrics today. This panel uses the ping counter's total rate as a proxy for job throughput.",
      "type": "stat",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "sentinel-prometheus" },
          "expr": "sum(rate(sentinel_ping_total[5m]))",
          "legendFormat": "jobs/sec",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 3 }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center"
      }
    },
    {
      "id": 8,
      "title": "API & Worker Logs",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 28 },
      "datasource": { "type": "loki", "uid": "sentinel-loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "sentinel-loki" },
          "expr": "{service=~\"api|worker\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["sentinel"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Sentinel Overview",
  "uid": "sentinel-overview",
  "version": 1,
  "weekStart": ""
}
